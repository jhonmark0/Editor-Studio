{
  "name": "editor-studio",
  "version": "2.0.0",
  "description": "A local photo, PDF, Word, and video editor",
  "main": "src/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "build:web": "node web/build.mjs"
  },
  "devDependencies": {
    "@ffmpeg/ffmpeg": "0.12.15",
    "electron": "^45.4.1",
    "electron-builder": "^26.0.12",
    "esbuild": "0.25.5",
    "pdfjs-dist": "4.10.38"
  },
  "dependencies": {
    "docx": "^9.16.0",
    "docx-preview": "^0.4.1",
    "electron-updater": "^6.8.11",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.2.0",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "sharp": "^0.35.5"
  },
  "build": {
    "appId": "com.editorstudio.app",
    "productName": "Editor Studio",
    "artifactName": "Editor-Studio-Setup-v${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/logo.ico",
      "signtoolOptions": {
        "certificateSha1": "FBCEE81BEE1EAEA1CCE523B44E219EA52D7BCF74",
        "publisherName": "CN=Editor Studio Local Testing"
      }
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jhonmark0",
        "repo": "Editor-Studio",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Editor Studio"
    }
  }
}
